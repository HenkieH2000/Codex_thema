kipedia/commons/thumb/9/92/Audi-Logo_2016.svg/500px-Audi-Logo_2016.svg.png' },\n    { name: 'SEAT',       url: 'https://supertune.nl/seat-chiptuning/',         img: 'https://logos-world.net/wp-content/uploads/2021/10/SEAT-Logo.png' },\n    { name: 'Skoda',      url: 'https://supertune.nl/skoda-chiptuning/',        img: 'https://cdn.freebiesupply.com/logos/large/2x/skoda-6-logo-png-transparent.png' },\n    { name: 'Cupra',      url: 'https://supertune.nl/cupra-chiptuning/',        img: 'https://upload.wikimedia.org/wikipedia/commons/thumb/7/70/Cupra.svg/500px-Cupra.svg.png' },\n    { name: 'Ford',       url: 'https://supertune.nl/ford-chiptuning/',         img: 'https://upload.wikimedia.org/wikipedia/commons/thumb/a/a0/Ford_Motor_Company_Logo.svg/500px-Ford_Motor_Company_Logo.svg.png' },\n    { name: 'Mini',       url: 'https://supertune.nl/mini-chiptuning/',         img: 'https://pngimg.com/uploads/mini/mini_PNG11789.png' },\n    { name: 'Mercedes',   url: 'https://supertune.nl/mercedes-chiptuning/',     img: 'https://upload.wikimedia.org/wikipedia/commons/thumb/9/90/Mercedes-Logo.svg/960px-Mercedes-Logo.svg.png' },\n    { name: 'Alfa Romeo', url: 'https://supertune.nl/alfa-romeo-chiptuning/',   img: 'https://supertune.nl/wp-content/uploads/2026/05/current-badge_457d965994803bd415fc9735d023d1eb.png' },\n    { name: 'Opel',       url: 'https://supertune.nl/opel-chiptuning/',         img: 'https://pngimg.com/uploads/opel/opel_PNG1.png' },\n    { name: 'Renault',    url: 'https://supertune.nl/renault-chiptuning/',      img: 'https://upload.wikimedia.org/wikipedia/commons/a/a5/Renault_2021.svg' },\n    { name: 'Peugeot',    url: 'https://supertune.nl/peugeot-chiptuning/',      img: 'https://1000logos.net/wp-content/uploads/2021/02/Peugeot-logo.png' },\n  ];\n  var track = document.getElementById('logotrack');\n  var all = brands.concat(brands);\n  all.forEach(function(b) {\n    var a = document.createElement('a');\n    a.href = b.url;\n    a.className = 'logo-card';\n  