{% comment %}
  Snippet: snippets/henk-upsell-products.liquid
  Gebruik: {% render 'henk-upsell-products' %}
{% endcomment %}

{% assign minimum_bundle_discount = 5 %}

<div class="bundle-wrapper"
     data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=10"
     data-main-variant="{{ product.selected_or_first_available_variant.id }}"
     data-main-product="{{ product.id }}"
     data-pool-collections="{% for col in product.collections %}{{ col.handle }}{% unless forloop.last %},{% endunless %}{% endfor %}">

  <h2 class="bundle-header">Maak bundel compleet</h2>

  <div class="bundle-list">
    <div class="bundle-recommendations-container">

      {% if recommendations.performed and recommendations.products_count > 0 %}
        {% for item in recommendations.products limit: 10 %}

          {% assign base_price = item.price %}
          {% assign compare_price = item.compare_at_price %}
          {% assign active_discount_percentage = 0.0 %}
          {% assign final_percentage_to_apply = minimum_bundle_discount %}

          {% if compare_price > base_price %}
              {% assign price_difference = compare_price | minus: base_price %}
              {% assign active_discount_percentage = price_difference | times: 100.0 | divided_by: compare_price | ceil %}
          {% endif %}

          {% if active_discount_percentage > minimum_bundle_discount %}
              {% assign final_percentage_to_apply = active_discount_percentage %}
              {% assign display_old_price = compare_price %}
          {% else %}
              {% assign final_percentage_to_apply = minimum_bundle_discount %}
              {% assign display_old_price = base_price %}
          {% endif %}

          {% assign discount_factor = 100.0 | minus: final_percentage_to_apply | divided_by: 100.0 %}
          {% assign final_discounted_price = base_price | times: discount_factor | round %}

          <div class="bundle-card recommended-product"
               data-price="{{ final_discounted_price }}"
               data-variant-id="{{ item.selected_or_first_available_variant.id }}"
               data-old-price="{{ display_old_price }}"
               data-pct="{{ final_percentage_to_apply }}"
               data-title="{{ item.title | escape }}"
               data-vendor="{{ item.vendor | escape }}"
               data-url="{{ item.url }}"
               data-img="{{ item.featured_image | img_url: '200x' }}">
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>

  <div class="bundle-footer"></div>
</div>

{% comment %} ── Alternatief-popup (modal) ── {% endcomment %}
<div class="bundle-alt-overlay" id="bundle-alt-overlay" style="display:none;" aria-hidden="true">
  <div class="bundle-alt-modal" role="dialog" aria-modal="true" aria-label="Kies een alternatief product">
    <div class="bundle-alt-header">
      <span class="bundle-alt-label">Kies een alternatief</span>
      <span class="bundle-alt-close" id="bundle-alt-close" role="button" tabindex="0" aria-label="Sluiten">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </span>
    </div>
    <div class="bundle-alt-grid" id="bundle-alt-grid"></div>
  </div>
</div>

<style>
  .bundle-wrapper { margin-top: 12px; margin-bottom: 0; }
  .bundle-header { font-size: 13px; font-weight: 700; color: #030a22; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
  .bundle-header svg { color: #FF7E00; flex-shrink: 0; }
  .bundle-recommendations-container { display: flex; flex-direction: column; gap: 8px; }
  .bundle-card { display: flex; align-items: center; gap: 0; border: 1px solid #e8eaf0; border-radius: 10px; padding: 10px 12px; background: #fff; cursor: pointer; user-select: none; transition: border-color 0.2s ease, background 0.2s ease; position: relative; }
  .bundle-card:hover { background: #fafafa; border-color: #d0d3dc; }
  .bundle-card.is-checked { border-color: #FF7E00; background: #fffaf5; }
  .bundle-checkbox-wrapper { padding-right: 12px; flex-shrink: 0; }
  .bundle-custom-checkbox { display: block; cursor: pointer; }
  .bundle-custom-checkbox input { display: none; }
  .bundle-checkmark { width: 22px; height: 22px; border-radius: 6px; border: 2px solid #d1d5db; background: #fff; display: flex; align-items: center; justify-content: center; transition: all 0.15s ease; flex-shrink: 0; }
  .bundle-checkmark svg { color: #fff; opacity: 0; transition: opacity 0.15s ease; }
  .bundle-custom-checkbox input:checked + .bundle-checkmark { background: #FF7E00; border-color: #FF7E00; }
  .bundle-custom-checkbox input:checked + .bundle-checkmark svg { opacity: 1; }
  .bundle-image-wrap { flex-shrink: 0; display: block; margin-right: 12px; }
  .bundle-image-wrap img { width: 48px; height: 48px; object-fit: contain; border-radius: 6px; border: 1px solid #f0f2f5; display: block; }
  .bundle-info { flex: 1; display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .bundle-title { font-size: 12px; font-weight: 600; color: #030a22; line-height: 1.3; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .bundle-prices { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .price-current { font-size: 13px; font-weight: 700; color: #030a22; }
  .price-old { font-size: 11px; color: #9ca3af; text-decoration: line-through; }
  .discount-badge { background: #FE0000; color: #fff; font-size: 10px; font-weight: 700; padding: 2px 5px; border-radius: 8px; line-height: 1.4; }
  .bundle-actions { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; gap: 8px; flex-shrink: 0; align-self: stretch; padding-left: 12px; }
  .bundle-alt-btn { display: inline-flex; align-items: center; justify-content: center; gap: 3px; font-size: 11px; color: #FF7E00; font-weight: 700; cursor: pointer; line-height: 1; padding: 7px 14px; border: 1px solid #ffd3ac; border-radius: 100px; background: #fff7ef; white-space: nowrap; transition: background .15s, border-color .15s, color .15s; }
  .bundle-alt-btn:hover { background: #FF7E00; border-color: #FF7E00; color: #fff; }
  .bundle-info-btn { flex-shrink: 0; display: flex; align-items: center; text-decoration: none; }
  .info-circle { width: 22px; height: 22px; background: #fff0e0; color: #FF7E00; border-radius: 50%; text-align: center; line-height: 22px; font-size: 12px; font-weight: 700; cursor: pointer; transition: background 0.2s; }
  .bundle-info-btn:hover .info-circle { background: #FF7E00; color: #fff; }
  .bundle-footer { height: 0; overflow: hidden; }

  /* ── Alternatief-popup (modal) ── */
  .bundle-alt-overlay { position: fixed !important; inset: 0 !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; width: 100% !important; height: 100% !important; margin: 0 !important; background: rgba(3,10,34,.55); display: flex; align-items: center; justify-content: center; z-index: 2147483000 !important; padding: 22px; box-sizing: border-box; opacity: 0; transition: opacity .2s ease; }
  .bundle-alt-overlay.is-open { opacity: 1; }
  .bundle-alt-modal { background: #fff; border-radius: 14px; width: 100%; max-width: 860px; max-height: 88vh; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 24px 60px -12px rgba(3,10,34,.35); transform: translateY(12px) scale(.98); transition: transform .2s ease; }
  .bundle-alt-overlay.is-open .bundle-alt-modal { transform: none; }
  .bundle-alt-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid #e8eaf0; flex-shrink: 0; }
  .bundle-alt-label { font-size: 15px; font-weight: 800; color: #030a22; }
  .bundle-alt-close { background: #f4f4f4 !important; border: none !important; box-shadow: none !important; width: 32px !important; height: 32px !important; min-width: 0 !important; max-width: 32px !important; min-height: 0 !important; max-height: 32px !important; border-radius: 50% !important; color: #6b7280 !important; cursor: pointer; display: flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important; transition: background .15s, color .15s; padding: 0 !important; margin: 0 !important; line-height: 0 !important; }
  .bundle-alt-close:hover { background: #FF7E00 !important; color: #fff !important; }
  .bundle-alt-close svg { width: 14px !important; height: 14px !important; flex-shrink: 0 !important; }
  .bundle-alt-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; padding: 20px; overflow-y: auto; -webkit-overflow-scrolling: touch; }
  @media (max-width: 720px) { .bundle-alt-grid { grid-template-columns: repeat(3, 1fr); } }
  .bundle-alt-card { border: 1px solid #e8eaf0; border-radius: 10px; padding: 10px; cursor: pointer; position: relative; transition: border-color .2s, box-shadow .2s; background: #fff; display: flex; flex-direction: column; }
  .bundle-alt-card:hover { border-color: #FF7E00; box-shadow: 0 6px 16px -8px rgba(255,126,0,.45); }
  .bundle-alt-card--active { border-color: #FF7E00; background: #fffaf5; cursor: default; }
  .bundle-alt-card--active:hover { box-shadow: none; }
  .bundle-alt-active-tag { display: none; position: absolute; top: 6px; left: 6px; background: #FF7E00; color: #fff; font-size: 9px; font-weight: 700; padding: 3px 6px; border-radius: 5px; align-items: center; gap: 3px; z-index: 2; }
  .bundle-alt-card--active .bundle-alt-active-tag { display: inline-flex; }
  .bundle-alt-card img { width: 100%; aspect-ratio: 1; object-fit: contain; border-radius: 6px; display: block; padding: 4px; box-sizing: border-box; }
  .bundle-alt-discount-badge { position: absolute; top: 6px; right: 6px; background: #FE0000; color: #fff; font-size: 9px; font-weight: 700; padding: 2px 4px; border-radius: 4px; }
  .bundle-alt-vendor { display: block; font-size: 10px; color: #6b7280; margin-top: 6px; }
  .bundle-alt-title { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; font-size: 11px; font-weight: 600; color: #030a22; line-height: 1.3; margin: 2px 0 6px; }
  .bundle-alt-prices { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; margin-top: auto; }

  @media (max-width: 640px) {
    .bundle-alt-overlay { padding: 0; align-items: flex-end; }
    .bundle-alt-modal { max-width: 100%; max-height: 90vh; border-radius: 16px 16px 0 0; }
    .bundle-alt-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; padding: 16px; }
  }
  @media (max-width: 360px) {
    .bundle-alt-grid { grid-template-columns: repeat(1, 1fr); }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const wrapper = document.querySelector('.bundle-wrapper');
  if (!wrapper) return;

  const container        = wrapper.querySelector('.bundle-recommendations-container');
  const baseUrl          = wrapper.dataset.url;
  const complementaryUrl = baseUrl + '&intent=complementary';
  let   productForm      = document.querySelector('form[action*="/cart/add"]');

  const altOverlay = document.getElementById('bundle-alt-overlay');
  const altModal   = altOverlay.querySelector('.bundle-alt-modal');
  const altGrid    = document.getElementById('bundle-alt-grid');
  const altClose   = document.getElementById('bundle-alt-close');

  if (altOverlay && altOverlay.parentElement !== document.body) document.body.appendChild(altOverlay);

  const VISIBLE_SLOTS = 2;
  const TARGET_MIN    = 24;   // streef naar 24 producten → 20+ alternatieven in de popup

  /* ── ENIGE BRON VAN WAARHEID ──
     allCards : alle beschikbare producten (data-objecten met variantId)
     slots    : [{ index, checked }] per zichtbaar vak. Alles leest hieruit. */
  let allCards = [];
  let slots = [];

  function money(cents) {
    const n = parseInt(cents);
    if (!n || isNaN(n)) return '';
    return (n / 100).toFixed(2).replace('.', ',').replace(',00', ',-');
  }

  function escHtml(s) {
    return (s == null ? '' : String(s))
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function getMainVariantId() {
    const liquidVariant = wrapper.dataset.mainVariant;
    if (liquidVariant) return String(liquidVariant);
    if (productForm) {
      const hidden = productForm.querySelector('input[name="id"][type="hidden"]');
      if (hidden && hidden.value) return String(hidden.value);
      const any = productForm.querySelector('[name="id"]');
      if (any && any.value) return String(any.value);
    }
    const g = document.querySelector('form[action*="/cart/add"] [name="id"]');
    if (g && g.value) return String(g.value);
    return null;
  }

  /* ── Databronnen ── */
  function cardFromEl(c) {
    return {
      variantId : c.dataset.variantId ? String(c.dataset.variantId) : '',
      price     : c.dataset.price,
      oldPrice  : c.dataset.oldPrice,
      pct       : c.dataset.pct,
      title     : c.dataset.title,
      vendor    : c.dataset.vendor,
      url       : c.dataset.url,
      img       : c.dataset.img
    };
  }

  // Aanbevelingen uit de section-render (max 10 per intent).
  function parseRecommendations(url) {
    return fetch(url)
      .then(r => r.text())
      .then(text => {
        const el = document.createElement('div');
        el.innerHTML = text;
        return Array.from(el.querySelectorAll('.bundle-card')).map(cardFromEl);
      })
      .catch(() => []);
  }

  // Product uit /collections/<handle>/products.json omzetten naar een kaart.
  function cardFromJson(p) {
    if (!p || String(p.id) === String(wrapper.dataset.mainProduct)) return null;
    const v = p.variants && p.variants[0];
    if (!v || v.available === false) return null;
    const baseCents = Math.round(parseFloat(v.price) * 100);
    if (!baseCents) return null;
    let pct = 5, oldCents = baseCents;
    const cmp = v.compare_at_price ? Math.round(parseFloat(v.compare_at_price) * 100) : 0;
    if (cmp > baseCents) {
      const active = Math.ceil((cmp - baseCents) * 100 / cmp);
      if (active > 5) { pct = active; oldCents = cmp; }
    }
    const priceCents = Math.round(baseCents * (100 - pct) / 100);
    let img = '';
    if (p.images && p.images[0]) img = (typeof p.images[0] === 'string') ? p.images[0] : p.images[0].src;
    return {
      variantId : String(v.id),
      price     : String(priceCents),
      oldPrice  : String(oldCents),
      pct       : String(pct),
      title     : p.title,
      vendor    : p.vendor,
      url       : '/products/' + p.handle,
      img       : img
    };
  }

  function fetchCollection(handle) {
    return fetch('/collections/' + handle + '/products.json?limit=30')
      .then(r => r.ok ? r.json() : { products: [] })
      .then(j => (j.products || []).map(cardFromJson).filter(Boolean))
      .catch(() => []);
  }

  function goodHandles() {
    const BAD = /^(all|all-products.*|alle-producten|orderly.*|tryon.*)$/i;
    const NUM = /^<?\d+(-\d+)?$/;
    return (wrapper.dataset.poolCollections || '')
      .split(',').map(s => s.trim()).filter(Boolean)
      .filter(h => !BAD.test(h) && !NUM.test(h));
  }

  /* ── Eén vak renderen uit state ── */
  function buildCard(slotIndex) {
    const slot = slots[slotIndex];
    const d = allCards[slot.index];

    const card = document.createElement('div');
    card.className = 'bundle-card recommended-product' + (slot.checked ? ' is-checked' : '');
    card.dataset.slot = String(slotIndex);

    card.innerHTML = `
      <div class="bundle-checkbox-wrapper">
        <label class="bundle-custom-checkbox" onclick="event.stopPropagation()">
          <input type="checkbox" class="bundle-checkbox add-on-checkbox" ${slot.checked ? 'checked' : ''}>
          <span class="bundle-checkmark">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
        </label>
      </div>
      <a href="${escHtml(d.url)}" class="bundle-image-wrap" onclick="event.stopPropagation()">
        <img src="${escHtml(d.img)}" alt="${escHtml(d.title)}" loading="lazy">
      </a>
      <div class="bundle-info">
        <div class="bundle-title">${escHtml(d.title)}</div>
        <div class="bundle-prices">
          <span class="price-current">${money(d.price)}</span>
          <span class="price-old">${money(d.oldPrice)}</span>
          <span class="discount-badge">-${escHtml(d.pct)}%</span>
        </div>
      </div>
      <div class="bundle-actions">
        <a href="${escHtml(d.url)}" class="bundle-info-btn bundle-icon-link" title="Meer info" onclick="event.stopPropagation()">
          <div class="info-circle">i</div>
        </a>
        <span class="bundle-alt-btn">
          Wijzig
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </span>
      </div>`;

    const cb = card.querySelector('.bundle-checkbox');
    function setChecked(v) {
      slots[slotIndex].checked = v;
      cb.checked = v;
      card.classList.toggle('is-checked', v);
    }

    card.querySelector('.bundle-alt-btn').addEventListener('click', e => { e.stopPropagation(); showAltPanel(slotIndex); });
    cb.addEventListener('change', () => setChecked(cb.checked));
    card.addEventListener('click', function (e) {
      if (e.target.closest('.bundle-alt-btn')) return;
      if (e.target.closest('.bundle-icon-link')) return;
      if (e.target.closest('.bundle-image-wrap')) return;
      if (e.target.closest('.bundle-custom-checkbox')) return;
      setChecked(!slots[slotIndex].checked);
    });

    return card;
  }

  function renderSlots() {
    container.innerHTML = '';
    slots.forEach((_, i) => container.appendChild(buildCard(i)));
    if (allCards.length <= slots.length) {
      container.querySelectorAll('.bundle-alt-btn').forEach(b => b.style.display = 'none');
    }
  }

  /* ── Popup ── */
  function openAlt() {
    altOverlay.style.display = 'flex';
    altOverlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    void altOverlay.offsetWidth;
    altOverlay.classList.add('is-open');
  }
  function closeAlt() {
    altOverlay.classList.remove('is-open');
    altOverlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    setTimeout(() => { altOverlay.style.display = 'none'; }, 200);
  }

  function showAltPanel(slotIndex) {
    altGrid.innerHTML = '';
    altGrid.scrollTop = 0;

    allCards.forEach((d, i) => {
      const usedElsewhere = slots.some((s, si) => s.index === i && si !== slotIndex);
      if (usedElsewhere) return;
      const isCurrent = slots[slotIndex].index === i;
      const el = document.createElement('div');
      el.className = 'bundle-alt-card' + (isCurrent ? ' bundle-alt-card--active' : '');
      el.innerHTML = `
        <span class="bundle-alt-active-tag">
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          Gekozen
        </span>
        <div class="bundle-alt-discount-badge">-${escHtml(d.pct)}%</div>
        <img src="${escHtml(d.img)}" alt="${escHtml(d.title)}" loading="lazy">
        <span class="bundle-alt-vendor">${escHtml(d.vendor)}</span>
        <span class="bundle-alt-title">${escHtml(d.title)}</span>
        <div class="bundle-alt-prices">
          <span class="price-current">${money(d.price)}</span>
          <span class="price-old">${money(d.oldPrice)}</span>
        </div>`;
      if (!isCurrent) el.addEventListener('click', () => swapSlot(slotIndex, i));
      altGrid.appendChild(el);
    });

    openAlt();
  }

  function swapSlot(slotIndex, newIndex) {
    slots[slotIndex].index = newIndex;   // checked blijft
    renderSlots();
    closeAlt();
  }

  altClose.addEventListener('click', closeAlt);
  altClose.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); closeAlt(); } });
  altOverlay.addEventListener('click', e => { if (!altModal.contains(e.target)) closeAlt(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && altOverlay.classList.contains('is-open')) closeAlt(); });

  /* ── Laden (aanbevelingen + collectie-aanvulling tot 20+) ── */
  (async function load() {
    const mainId = String(getMainVariantId() || '');
    const seen = new Set();
    function push(arr) {
      for (const d of arr) {
        if (!d || !d.variantId) continue;
        if (d.variantId === mainId) continue;
        if (seen.has(d.variantId)) continue;
        seen.add(d.variantId);
        allCards.push(d);
      }
    }

    try {
      const [comp, std] = await Promise.all([parseRecommendations(complementaryUrl), parseRecommendations(baseUrl)]);
      push(comp); push(std);

      // Aanvullen met collectie-producten tot we >= TARGET_MIN hebben.
      for (const h of goodHandles()) {
        if (allCards.length >= TARGET_MIN) break;
        push(await fetchCollection(h));
      }
    } catch (e) {
      console.error('Upsell laadfout:', e);
    }

    if (allCards.length === 0) { wrapper.style.display = 'none'; return; }

    const count = Math.min(VISIBLE_SLOTS, allCards.length);
    slots = [];
    for (let i = 0; i < count; i++) slots.push({ index: i, checked: false });
    renderSlots();
  })();

  /* ─────────── Toevoegen aan winkelwagen ───────────
     De sticky winkelwagenbalk staat BUITEN het productformulier. Daarom vangen
     we de klik/submit af op WINDOW (capture) — dat draait vóór álle thema-
     listeners, ongeacht welke knop. Hoofdproduct + upsells gaan atomisch in de
     mand; de drawer opent PAS daarna. Variant-ID's komen 100% uit de state. */

  function hasCheckedAddons() { return slots.some(s => s.checked); }

  function collectItems() {
    const items = [];
    const mainId = getMainVariantId();
    if (mainId) {
      const qEl = (productForm && productForm.querySelector('[name="quantity"]')) || document.querySelector('form[action*="/cart/add"] [name="quantity"]');
      const quantity = qEl ? (parseInt(qEl.value) || 1) : 1;
      items.push({ id: mainId, quantity: quantity });
    }
    slots.forEach(s => {
      if (!s.checked) return;
      const d = allCards[s.index];
      if (d && d.variantId) items.push({ id: d.variantId, quantity: 1, properties: { _upsell: 'true' } });
    });
    return items;
  }

  function updateCartCount(cart, sideCartDoc) {
    const totalQty = sideCartDoc?.querySelector('[data-totalqty]')?.dataset.totalqty || cart.item_count;
    const totalPrice = sideCartDoc?.querySelector('[data-totalprice]')?.dataset.totalprice;
    document.querySelectorAll('#cart-count,[data-cart-count],[data-cart-item-count],.cart-count,.cart__count,.header__cart-count,.cart-count-bubble').forEach(el => {
      el.textContent = totalQty;
      el.setAttribute('data-count', totalQty);
      if (parseInt(totalQty, 10) > 0) el.removeAttribute('hidden');
    });
    if (totalPrice) {
      document.querySelectorAll('#cart-total,[data-cart-total]').forEach(el => { el.textContent = totalPrice; });
    }
  }

  function refreshDrawerContent(addResponse) {
    const sideCartContainer = document.getElementById('cart');
    const sideCartHtml = addResponse?.sections?.['side-cart'];
    if (!sideCartContainer || !sideCartHtml) return Promise.resolve(null);
    const sideCartDoc = new DOMParser().parseFromString(sideCartHtml, 'text/html');
    const sideCartSection = sideCartDoc.querySelector('#shopify-section-side-cart');
    if (!sideCartSection) return Promise.resolve(null);
    sideCartContainer.innerHTML = sideCartSection.innerHTML;
    window.dispatchEvent(new CustomEvent('modulePanel'));
    window.dispatchEvent(new CustomEvent('listCart'));
    window.dispatchEvent(new CustomEvent('semanticInput'));
    window.dispatchEvent(new CustomEvent('formValidate'));
    window.dispatchEvent(new CustomEvent('accordeon'));
    if (window.ajaxCart && typeof window.ajaxCart.init === 'function') window.ajaxCart.init();
    return Promise.resolve(sideCartDoc);
  }

  function openCartDrawer() {
    if (window.ajaxCart && typeof window.ajaxCart.load === 'function') {
      window.ajaxCart.load(false, true, false, false);
      return;
    }
    const drawerEl = document.querySelector('cart-drawer');
    if (drawerEl) {
      if (typeof drawerEl.open === 'function') { drawerEl.open(); return; }
      drawerEl.setAttribute('open', ''); drawerEl.removeAttribute('aria-hidden'); return;
    }
    for (const sel of ['a[data-panel="cart"]','[data-cart-toggle]','[data-drawer-trigger="cart"]','.js-drawer-open-cart','#cart-icon-bubble','[aria-label*="winkelwagen" i]','.cart-toggle','.cart__toggle','.header__cart','.site-header__cart']) {
      const el = document.querySelector(sel);
      if (el) { el.click(); return; }
    }
    for (const [name, target] of [['CartDrawer:open', document.body],['cart:open', document],['cart:toggle', document],['theme:cart:open', document],['open-cart', document],['cartOpen', document]]) {
      target.dispatchEvent(new CustomEvent(name, { bubbles: true }));
    }
  }

  function afterAddUI(addResponse, items) {
    return Promise.all([
      fetch('/cart.js').then(r => r.json()).catch(() => null),
      refreshDrawerContent(addResponse).catch(() => null)
    ]).then(([cart, sideCartDoc]) => {
      try {
        if (cart) updateCartCount(cart, sideCartDoc);
        document.dispatchEvent(new CustomEvent('cart:add', { bubbles: true, detail: { items } }));
        document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: { cart } }));
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
        window.dispatchEvent(new CustomEvent('cart-update', { bubbles: true, detail: { cart } }));
        document.dispatchEvent(new CustomEvent('theme:cart:update', { bubbles: true, detail: { cart } }));
      } catch (uiErr) { console.error('Upsell UI-fout:', uiErr); }
      openCartDrawer(); // drawer opent PAS nadat alles is toegevoegd
    });
  }

  function addBundleToCart() {
    const items = collectItems();
    if (!items.length) return Promise.resolve();
    return fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({
        items,
        attributes: { 'Upsell gebruikt': 'henk-upsell' },
        sections: 'side-cart',
        sections_url: window.location.pathname
      })
    })
    .then(r => { if (!r.ok) return r.json().then(e => { throw new Error(e.message || ('HTTP ' + r.status)); }); return r.json(); })
    .then(addResponse => afterAddUI(addResponse, items))
    .catch(err => {
      console.error('Upsell cart fout:', err);
      alert('Er ging iets mis bij het toevoegen. Probeer het opnieuw.');
    });
  }

  // Herkennen van winkelwagen-knoppen.
  const ATC_BROAD  = '[name="add"], button[type="submit"], input[type="submit"], .product-form__submit, .add-to-cart, .add_to_cart, [data-add-to-cart], [data-add-to-cart-trigger], .product-form__cart-submit, .btn-addtocart, .btn--add-to-cart';
  const ATC_STRICT = '[name="add"], .product-form__submit, .add-to-cart, .add_to_cart, [data-add-to-cart], [data-add-to-cart-trigger], .product-form__cart-submit, .btn-addtocart, .btn--add-to-cart';

  function isMainTrigger(btn) {
    const form = btn.closest('form[action*="/cart/add"]');
    if (form) {
      const idInput = form.querySelector('[name="id"]');
      const formId = idInput && idInput.value ? String(idInput.value) : '';
      return !formId || formId === String(getMainVariantId() || '');
    }
    // Geen cart-form (sticky balk): alleen echte ATC-knoppen accepteren.
    return btn.matches(ATC_STRICT) || /in\s*winkelwagen|toevoegen|add to cart/i.test((btn.textContent || '').trim());
  }

  let isAdding = false;
  function takeOver(e, btn) {
    e.preventDefault();
    e.stopImmediatePropagation();
    if (isAdding) return;
    isAdding = true;
    const original = btn ? btn.innerHTML : '';
    if (btn) { btn.disabled = true; btn.setAttribute('aria-busy', 'true'); btn.style.pointerEvents = 'none'; btn.style.opacity = '0.75'; }
    addBundleToCart().finally(() => {
      isAdding = false;
      if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); btn.style.pointerEvents = ''; btn.style.opacity = ''; if (original) btn.innerHTML = original; }
    });
  }

  window.addEventListener('click', function (e) {
    if (!hasCheckedAddons()) return;
    const btn = e.target.closest && e.target.closest(ATC_BROAD);
    if (!btn) return;
    if (!isMainTrigger(btn)) return;
    takeOver(e, btn);
  }, true);

  window.addEventListener('submit', function (e) {
    if (!hasCheckedAddons()) return;
    const form = e.target;
    if (!form.matches || !form.matches('form[action*="/cart/add"]')) return;
    const idInput = form.querySelector('[name="id"]');
    const formId = idInput && idInput.value ? String(idInput.value) : '';
    if (formId && formId !== String(getMainVariantId() || '')) return; // ander product
    takeOver(e, form.querySelector(ATC_BROAD));
  }, true);
});
</script>
