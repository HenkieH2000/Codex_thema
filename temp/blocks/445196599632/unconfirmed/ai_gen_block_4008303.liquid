{% doc %}
  @prompt
    holografische productkaarten bij alleen GLOSSIO producten
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% assign is_glossio = false %}
{% if product.vendor == 'GLOSSIO' %}
  {% assign is_glossio = true %}
{% endif %}

{% if is_glossio %}
  {% style %}
    .ai-holographic-card-{{ ai_gen_id }} {
      display: block;
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
    }

    .ai-holographic-card__wrapper-{{ ai_gen_id }} {
      position: relative;
      overflow: hidden;
      border-radius: {{ block.settings.border_radius }}px;
      background: {{ block.settings.card_background }};
      padding: {{ block.settings.card_padding }}px;
      transition: transform 0.3s ease;
    }

    .ai-holographic-card__wrapper-{{ ai_gen_id }}:hover {
      transform: translateY(-{{ block.settings.hover_lift }}px);
    }

    .ai-holographic-card__hologram-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      opacity: {{ block.settings.hologram_opacity }};
      background: linear-gradient(
        45deg,
        transparent 30%,
        {{ block.settings.hologram_color_1 }} 40%,
        {{ block.settings.hologram_color_2 }} 50%,
        {{ block.settings.hologram_color_3 }} 60%,
        transparent 70%
      );
      background-size: 200% 200%;
      animation: ai-holographic-shimmer-{{ ai_gen_id }} {{ block.settings.animation_speed }}s ease-in-out infinite;
      mix-blend-mode: overlay;
    }

    @keyframes ai-holographic-shimmer-{{ ai_gen_id }} {
      0% {
        background-position: 0% 0%;
      }
      50% {
        background-position: 100% 100%;
      }
      100% {
        background-position: 0% 0%;
      }
    }

    .ai-holographic-card__image-{{ ai_gen_id }} {
      position: relative;
      width: 100%;
      margin-bottom: {{ block.settings.image_spacing }}px;
      border-radius: {{ block.settings.image_border_radius }}px;
      overflow: hidden;
    }

    .ai-holographic-card__image-{{ ai_gen_id }} img {
      width: 100%;
      height: auto;
      display: block;
    }

    .ai-holographic-card__content-{{ ai_gen_id }} {
      position: relative;
      z-index: 1;
    }

    .ai-holographic-card__vendor-{{ ai_gen_id }} {
      font-size: {{ block.settings.vendor_font_size }}px;
      color: {{ block.settings.vendor_color }};
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 600;
    }

    .ai-holographic-card__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size }}px;
      color: {{ block.settings.title_color }};
      margin-bottom: 12px;
      font-weight: 700;
      line-height: 1.3;
    }

    .ai-holographic-card__title-{{ ai_gen_id }} a {
      color: inherit;
      text-decoration: none;
    }

    .ai-holographic-card__title-{{ ai_gen_id }} a:hover {
      opacity: 0.8;
    }

    .ai-holographic-card__price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_font_size }}px;
      color: {{ block.settings.price_color }};
      font-weight: 700;
      margin-bottom: 16px;
    }

    .ai-holographic-card__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_font_size }}px;
      color: {{ block.settings.description_color }};
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .ai-holographic-card__button-{{ ai_gen_id }} {
      display: inline-block;
      padding: 12px 24px;
      background-color: {{ block.settings.button_background }};
      color: {{ block.settings.button_text_color }};
      text-decoration: none;
      border-radius: {{ block.settings.button_border_radius }}px;
      font-weight: 600;
      transition: all 0.3s ease;
      border: none;
      cursor: pointer;
      font-size: 14px;
    }

    .ai-holographic-card__button-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.button_hover_background }};
      transform: scale(1.05);
    }

    @media screen and (max-width: 749px) {
      .ai-holographic-card-{{ ai_gen_id }} {
        width: 100%;
      }

      .ai-holographic-card__title-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.title_font_size }}px * 0.9);
      }

      .ai-holographic-card__price-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.price_font_size }}px * 0.9);
      }
    }
  {% endstyle %}

  <holographic-product-card-{{ ai_gen_id }}
    class="ai-holographic-card-{{ ai_gen_id }}"
    {{ block.shopify_attributes }}
  >
    <div class="ai-holographic-card__wrapper-{{ ai_gen_id }}">
      <div class="ai-holographic-card__hologram-{{ ai_gen_id }}"></div>

      {% if product.featured_image %}
        <div class="ai-holographic-card__image-{{ ai_gen_id }}">
          <img
            src="{{ product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt | escape }}"
            loading="lazy"
            width="{{ product.featured_image.width }}"
            height="{{ product.featured_image.height }}"
          >
        </div>
      {% endif %}

      <div class="ai-holographic-card__content-{{ ai_gen_id }}">
        {% if block.settings.show_vendor and product.vendor %}
          <div class="ai-holographic-card__vendor-{{ ai_gen_id }}">
            {{ product.vendor }}
          </div>
        {% endif %}

        {% if block.settings.show_title %}
          <h3 class="ai-holographic-card__title-{{ ai_gen_id }}">
            <a href="{{ product.url }}">{{ product.title }}</a>
          </h3>
        {% endif %}

        {% if block.settings.show_price %}
          <div class="ai-holographic-card__price-{{ ai_gen_id }}">
            {{ product.price | money }}
          </div>
        {% endif %}

        {% if block.settings.show_description and product.description != blank %}
          <div class="ai-holographic-card__description-{{ ai_gen_id }}">
            {{ product.description | strip_html | truncate: 120 }}
          </div>
        {% endif %}

        {% if block.settings.show_button %}
          <a
            href="{{ product.url }}"
            class="ai-holographic-card__button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </holographic-product-card-{{ ai_gen_id }}>

  <script>
    (function() {
      class HolographicProductCard{{ ai_gen_id }} extends HTMLElement {
        constructor() {
          super();
        }

        connectedCallback() {
          this.hologram = this.querySelector('.ai-holographic-card__hologram-{{ ai_gen_id }}');
          this.wrapper = this.querySelector('.ai-holographic-card__wrapper-{{ ai_gen_id }}');

          if (this.hologram && this.wrapper) {
            this.wrapper.addEventListener('mousemove', this.handleMouseMove.bind(this));
            this.wrapper.addEventListener('mouseleave', this.handleMouseLeave.bind(this));
          }
        }

        handleMouseMove(event) {
          const rect = this.wrapper.getBoundingClientRect();
          const x = ((event.clientX - rect.left) / rect.width) * 100;
          const y = ((event.clientY - rect.top) / rect.height) * 100;

          this.hologram.style.backgroundPosition = x + '% ' + y + '%';
        }

        handleMouseLeave() {
          this.hologram.style.backgroundPosition = '0% 0%';
        }
      }

      customElements.define('holographic-product-card-{{ ai_gen_id }}', HolographicProductCard{{ ai_gen_id }});
    })();
  </script>
{% endif %}

